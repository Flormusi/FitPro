# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# API Configuration
VITE_API_URL=http://localhost:5004/api
VITE_SOCKET_URL=http://localhost:5004

# Google Calendar API Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Contact info shown in the subscription page (after trainer signup)
# WhatsApp: country code + number, no spaces or symbols. Ej: 5491112345678
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=

# Stripe (optional, for international payments)
VITE_STRIPE_PUBLISHABLE_KEY=

# Development Auto Login (optional)
# Set to true and provide credentials to auto-login during development
VITE_DEV_AUTO_LOGIN=false
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=